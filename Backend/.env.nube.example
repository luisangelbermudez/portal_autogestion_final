# Plantilla DESPLIEGUE (nube). Local sigue usando .env. NO subas valores reales al repo.
# Estos mismos valores se cargan como variables de entorno en Render (ver render.yaml), no en un archivo.

# --- Base de datos MySQL/MariaDB en la nube (TiDB Cloud Starter u otro MySQL) ---
DB_HOST=<host del proveedor>
DB_PORT=<puerto, TiDB: 4000>
DB_USER=<usuario>
DB_PASSWORD=<contrasena>
DB_NAME=<nombre de la base, ahi se importa Database/portal_acegrasco_nube.sql>
DB_SSL=true
DB_SSL_CA=

# --- API (Render) ---
PORT=3000
JWT_SECRET=<texto largo aleatorio, Render puede generarlo>
JWT_EXPIRES_IN=8h
CORS_ORIGIN=<URL del frontend en Netlify, sin barra final>

# --- Correo (opcional; en Render usa puerto 2525, ej. Mailtrap) ---
SMTP_HOST=
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portal de Autogestión <correo@ejemplo.com>"

# --- Frontend: Frontend/src/environments/environment.prod.ts ---
# apiUrl: "https://<tu-servicio>.onrender.com/api"
